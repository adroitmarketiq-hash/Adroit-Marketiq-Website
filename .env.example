# Adroit Marketiq — form mail settings
#
# On Vercel: add these under Project → Settings → Environment Variables (Production and Preview),
# then redeploy. Do not upload a file containing real values.
#
# Locally: copy this file to .env.local, fill it in, and run `npm run dev`.
# .env.local is ignored by git and by Vercel.

# --- Required ---------------------------------------------------------------

# The Gmail or Google Workspace address that sends the mail
SMTP_USER=YOUR_GMAIL_ADDRESS_HERE

# A Google App Password (16 characters), NOT the normal account password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD_HERE

# Where enquiries and subscriptions are delivered. Separate several inboxes with commas.
MAIL_TO=RECIPIENT_EMAIL_HERE

# --- Optional (defaults shown) ----------------------------------------------

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=starttls          # starttls (port 587) | ssl (port 465) | none (local test server only)
# MAIL_FROM_NAME=Adroit Marketiq Website
# MAIL_FROM=                    # only if you have set up a "Send mail as" alias in Gmail
# SITE_NAME=Adroit Marketiq
# AUTO_REPLY=true               # send the visitor a confirmation of their enquiry
# ALLOWED_ORIGINS=              # extra sites allowed to post the form, comma separated
# RATE_LIMIT_MAX=5              # submissions allowed per visitor...
# RATE_LIMIT_WINDOW_SECONDS=600 # ...in this many seconds
# MIN_SECONDS=3                 # forms sent faster than this are treated as bots
# MAIL_DEBUG=false              # true = include the mail error in the response (testing only)
